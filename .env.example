# CurateNest Environment Configuration

# Server Port
PORT=5000

# MongoDB URI (Leave empty to use automatic embedded in-memory MongoDB)
MONGO_URI=

# JSON Web Token Secret
JWT_SECRET=curatenest_super_secret_jwt_key_2026

# Google Gemini API Key (Get from https://aistudio.google.com/)
GEMINI_API_KEY=

# ChromaDB Server URL (Optional; in-memory vector store runs automatically if not provided)
CHROMA_URL=http://localhost:8000
